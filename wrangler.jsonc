/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "perezautomotora-admin",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	
	// D1 Database Configuration
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "perez-automotora",
			"database_id": "9c2cb7f7-4eeb-4824-81ec-991af035d6c2"
		}
	],
	
	// R2 Bucket Configuration
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "perez-automotora",
			"preview_bucket_name": "perez-automotora"
		}
	],

	// Environment Variables
	"env": {
		"production": {
			"vars": {
				"NEXT_PUBLIC_R2_PUBLIC_URL": "https://pub-cb7d4efdfc49403585445ecc78709bc9.r2.dev"
			}
		},
		"preview": {
			"vars": {
				"NEXT_PUBLIC_R2_PUBLIC_URL": "https://pub-cb7d4efdfc49403585445ecc78709bc9.r2.dev"
			}
		}
	}
}


